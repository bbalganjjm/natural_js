{
  "name": "@bbalganjjm/natural_js",
  "version": "2.0.0-beta.0",
  "description": "CVC UI framework that attaches behavior to authored HTML.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbalganjjm/natural_js.git"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./page": {
      "types": "./build/page/index.d.ts",
      "import": "./build/page/index.js"
    },
    "./data": {
      "types": "./build/data/index.d.ts",
      "import": "./build/data/index.js"
    },
    "./ui": {
      "types": "./build/ui/index.d.ts",
      "import": "./build/ui/index.js"
    },
    "./comm": {
      "types": "./build/comm/index.d.ts",
      "import": "./build/comm/index.js"
    }
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test -c tests/playwright.config.ts",
    "example": "vite --config examples/vite/vite.config.ts",
    "test:consumers": "node tools/check-consumers.mjs",
    "docs:check": "node tools/knowledge-docs/knowledge-docs.mjs check",
    "docs:stamp": "node tools/knowledge-docs/knowledge-docs.mjs stamp",
    "test:packed-browser": "node tools/check-packed-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/bbalganjjm/natural_js#readme",
  "bugs": {
    "url": "https://github.com/bbalganjjm/natural_js/issues"
  }
}
