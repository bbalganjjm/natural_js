{
  "name": "@bbalganjjm/natural_js",
  "version": "2.0.0",
  "description": "Natural-JS is a JavaScript architectural framework designed for enterprise web applications, allowing intuitive, easy, and fast implementation of user interfaces.",
  "projects": [
    "https://github.com/bbalganjjm/natural_js"
  ],
  "homepage": "https://bbalganjjm.github.io/natural_js",
  "main": "./dist/natural.js",
  "module": "./dist/natural.mjs",
  "types": "./@types/index.d.ts",
  "exports": {
    ".": {
      "types": "./@types/index.d.ts",
      "import": "./dist/natural.mjs",
      "require": "./dist/natural.js"
    },
    "./core": {
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./ui": {
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbalganjjm/natural_js.git"
  },
  "keywords": [
    "UI Components",
    "Javascript UI",
    "Front-end",
    "Front-end Architecture",
    "Front-end framework",
    "jQuery Plugin",
    "jQuery Library",
    "Javascript Input Validation",
    "javascript AOP",
    "Single Page Applications",
    "SPA",
    "Javascript Front",
    "Data Grid",
    "Data Table",
    "table",
    "grid",
    "tree",
    "tabs",
    "natural-js",
    "naturaljs"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:prod": "NODE_ENV=production tsup",
    "build:es5": "tsup --config tsup.config.es5.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "migrate": "node scripts/migrate-to-n.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bbalganjjm/natural_js": "file:",
    "jquery": "3.7.1"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "tsup": "^8.0.1",
    "esbuild": "^0.19.0",
    "@swc/core": "^1.3.100",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "jquery": "^3.7.1"
  },
  "owners": [
    {
      "name": "Goldman Kim",
      "githubUsername": "bbalganjjm",
      "email": "bbalganjjm@gmail.com"
    }
  ],
  "license": "LGPL v2.1",
  "bugs": {
    "url": "https://github.com/bbalganjjm/natural_js/issues",
    "email": "bbalganjjm@gmail.com"
  }
}
